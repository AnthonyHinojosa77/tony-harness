# Copy to .env.local for local development. Never commit real values.

# Sign-in sessions. Any random string of 32+ characters. Required in production.
BETTER_AUTH_SECRET=
# The public address of the app. Local: http://localhost:3000. Vercel sets VERCEL_URL automatically.
BETTER_AUTH_URL=http://localhost:3000

# Postgres on Neon (through Vercel). Leave empty locally to use the built-in PGlite database.
DATABASE_URL=

# Sign-in providers. A provider's button appears only when both of its values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Apple needs four values from the Apple Developer account instead of a fixed secret.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_APP_BUNDLE_IDENTIFIER=

# Models, added in step 1.5.
OPENROUTER_API_KEY=
